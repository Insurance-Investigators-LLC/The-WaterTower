{
    "editor.formatOnSave": true,
    "files.autoSave": "onWindowChange",
    "editor.defaultFormatter": "GitHub.copilot-chat",
    "editor.wordWrap": "wordWrapColumn",
    "window.autoDetectColorScheme": true,
    "workbench.browser.experimentalUserTools.enabled": true,
    "workbench.browser.enableRemoteProxy": true,
    "workbench.browser.dataStorage": "workspace",
    "workbench.browser.showInTitleBar": true,
    "chat.unifiedAgentsBar.enabled": true,
    "workbench.browser.newTabPlacement": "sideGroup",
    "editor.formatOnPaste": true,
    "workbench.editor.alwaysShowEditorActions": true,
    "workbench.editor.autoLockGroups": {
        "default": true,
        "workbench.editor.processExplorer": false,
        "terminalEditor": false,
        "mainThreadWebview-simpleBrowser.view": false,
        "mainThreadWebview-browserPreview": false
    },
    "workbench.editor.centeredLayoutFixedWidth": true,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.wrapTabs": true,
    "workbench.editor.useModal": "all",
    "workbench.editor.titleScrollbarVisibility": "visible",
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "workbench.settings.editor": "json",
    "workbench.settings.openDefaultKeybindings": true,
    "workbench.settings.openDefaultSettings": true,
    "workbench.settings.useSplitJSON": true,
    "window.closeWhenEmpty": true,
    "git.addAICoAuthor": "all",
    "git.allowForcePush": true,
    "git.allowNoVerifyCommit": true,
    "git.alwaysShowStagedChangesResourceGroup": true,
    "git.alwaysSignOff": true,
    "git.autofetch": "all",
    "git.autoStash": true,
    "git.blame.editorDecoration.enabled": true,
    "interactiveWindow.executeWithShiftEnter": true,
    "interactiveWindow.promptToSaveOnClose": true,
    "notebook.diff.ignoreMetadata": true
}